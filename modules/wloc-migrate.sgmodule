#!name=WLOC 域名迁移（旧快捷指令免改）
#!desc=把 wloc-spoofer.wloc.workers.dev 的请求 302 到 wloc.bybot.si，旧快捷指令不用改一个字 | 与 Apple WLOC 模块同时启用
#!author=local
#!homepage=https://wloc.bybot.si/
#!category=Tools

[URL Rewrite]
^https?:\/\/wloc-spoofer\.wloc\.workers\.dev\/(.*) https://wloc.bybot.si/$1 302

[MITM]
hostname = %APPEND% wloc-spoofer.wloc.workers.dev
