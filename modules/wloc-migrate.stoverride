name: WLOC 域名迁移（旧快捷指令免改）
desc: "把 wloc-spoofer.wloc.workers.dev 的请求 302 到 wloc.bybot.si"
author: local
homepage: https://wloc.bybot.si/
category: Tools

http:
  mitm:
    - "wloc-spoofer.wloc.workers.dev"
  url-rewrite:
    - match: ^https?:\/\/wloc-spoofer\.wloc\.workers\.dev\/(.*)
      replace: https://wloc.bybot.si/$1
      type: 302
